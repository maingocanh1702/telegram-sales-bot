# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_TELEGRAM_ID=your_telegram_id

# Bank Info (for VietQR — fallback if no bank accounts in DB)
BANK_ID=970423
BANK_CODE=TPB
BANK_NAME=TPBank
BANK_ACCOUNT_NO=your_account_number
BANK_ACCOUNT_NAME=YOUR_NAME

# SePay (webhook auth + API)
SEPAY_API_KEY=your_sepay_api_key

# Admin Panel (separate key — falls back to SEPAY_API_KEY if not set)
ADMIN_API_KEY=your_admin_key_here

# Server
PORT=3000
WEBHOOK_PATH=/webhook/sepay

# Database (Railway persistent volume)
DB_PATH=/data/bot.db

# Order
ORDER_EXPIRY_MINUTES=5
